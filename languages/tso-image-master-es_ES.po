msgstr "No se encontró GhostScript en el PATH del servidor. Instálalo para comprimir PDFs desde la línea de comandos."

msgid "The PHP Imagick extension is not installed. Some PDF and image operations may be limited."
msgstr "La extensión PHP Imagick no está instalada. Algunas operaciones de PDF e imagen pueden estar limitadas."

msgid "PHP GD cannot read or write WebP (imagewebp and imagecreatefromwebp are missing). Enable WebP in PHP GD."
msgstr "PHP GD no puede leer ni escribir WebP (faltan imagewebp e imagecreatefromwebp). Activa WebP en PHP GD."

msgid "PHP GD cannot encode WebP (imagewebp is missing)."
msgstr "PHP GD no puede codificar WebP (falta imagewebp)."

msgid "PHP GD cannot decode WebP (imagecreatefromwebp is missing)."
msgstr "PHP GD no puede decodificar WebP (falta imagecreatefromwebp)."

msgid "PHP GD was compiled without AVIF support (imageavif and imagecreatefromavif are missing). Recompile GD with libavif or use WebP instead."
msgstr "PHP GD se compiló sin soporte AVIF (faltan imageavif e imagecreatefromavif). Recompila GD con libavif o usa WebP."

msgid "PHP GD cannot encode AVIF (imageavif is missing)."
msgstr "PHP GD no puede codificar AVIF (falta imageavif)."

msgid "PHP GD cannot decode AVIF (imagecreatefromavif is missing)."
msgstr "PHP GD no puede decodificar AVIF (falta imagecreatefromavif)."

